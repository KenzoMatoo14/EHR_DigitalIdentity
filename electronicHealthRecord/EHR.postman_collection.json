{
  "info": {
    "name": "EHR - Expediente Clínico (vía Gateway)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Pruebas del microservicio electronicHealthRecord a través del API Gateway (:5500). Llave del paciente = CURP. Correr en orden: 1 -> 6 y luego Errores."
  },
  "variable": [
    {
      "key": "gateway",
      "value": "http://localhost:5500"
    },
    {
      "key": "curp",
      "value": "MALK050614HJCTPN09"
    },
    {
      "key": "folio",
      "value": "0263328"
    },
    {
      "key": "antecedentesVersion",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Camino feliz",
      "item": [
        {
          "name": "1. Registrar paciente / guardar ficha",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Result = Success', () => pm.expect(pm.response.json().Result).to.eql('Success'));",
                  "pm.test('Regresa la misma CURP', () => pm.expect(pm.response.json().ficha.curp).to.eql(pm.collectionVariables.get('curp')));",
                  "pm.test('Fecha guardada como aaaammdd', () => pm.expect(pm.response.json().ficha.fechaNacimiento).to.eql('20050614'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gateway}}/fichaIdentificacion",
              "host": [
                "{{gateway}}"
              ],
              "path": [
                "fichaIdentificacion"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"curp\": \"{{curp}}\",\n  \"folio\": \"{{folio}}\",\n  \"nombre\": \"Kenzo\",\n  \"apellidoP\": \"Matoo\",\n  \"apellidoM\": \"López\",\n  \"fechaNacimiento\": \"2005-06-14\",\n  \"entidadNacimiento\": 14,\n  \"sexo\": 1,\n  \"nacionalidad\": 1,\n  \"entidadResidencia\": 14,\n  \"municipioResidencia\": \"039\",\n  \"localidadResidencia\": \"0001\",\n  \"grupoEtnico\": 0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "2. Consultar ficha",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Result = Success', () => pm.expect(pm.response.json().Result).to.eql('Success'));",
                  "pm.test('Catálogos regresan como id', () => pm.expect(pm.response.json().ficha.sexo).to.eql(1));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway}}/fichaIdentificacion?curp={{curp}}",
              "host": [
                "{{gateway}}"
              ],
              "path": [
                "fichaIdentificacion"
              ],
              "query": [
                {
                  "key": "curp",
                  "value": "{{curp}}"
                }
              ]
            }
          }
        },
        {
          "name": "3. Guardar antecedentes (crea versión)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// 201 = se creó una versión nueva; 200 = era igual a la última (al volver a correr la colección).",
                  "pm.test('Status 201 o 200', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "pm.test('Result = Success', () => pm.expect(pm.response.json().Result).to.eql('Success'));",
                  "const a = pm.response.json().antecedentes;",
                  "pm.test('Tiene versión y hash', () => { pm.expect(a.version).to.be.above(0); pm.expect(a.hash).to.have.lengthOf(64); });",
                  "pm.test('Matriz heredo-familiar ordenada por catálogo', () => pm.expect(a.heredoFamiliares[0]).to.eql({ padecimiento: 'DM', parentesco: 'MADRE' }));",
                  "pm.collectionVariables.set('antecedentesVersion', a.version);",
                  "// Solo si se creó una versión nueva: con 200 (sin cambios) se conserva el autor de la versión anterior.",
                  "if (pm.response.code === 201) pm.test('Autor registrado', () => pm.expect(a.elaboradoPor.nombre).to.eql('Enfermera de prueba'));",
                  "pm.test('Historia clínica completa (sin faltantes)', () => pm.expect(a.faltantes).to.have.lengthOf(0));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gateway}}/antecedentes",
